# ── Workspace ────────────────────────────────────────────────────────────
DATABRICKS_HOST="https://<workspace>.cloud.databricks.com"
DATABRICKS_WORKSPACE_ID="<numeric-workspace-id>"

# Apps (simulator + LakeEO) run their SQL queries via this CLI profile
DATABRICKS_CONFIG_PROFILE=DEFAULT
DATABRICKS_WAREHOUSE_ID="<sql-warehouse-id>"

# ── Telemetry auth ───────────────────────────────────────────────────────
# Set DATABRICKS_AUTH_TYPE=oauth to enable token refresh.
#
# Auth methods (DATABRICKS_AUTH_METHOD):
#   zerobus — client-credentials grant scoped to the Zerobus Ingest OTLP endpoint.
#             Tokens are bound to one table, so one is fetched per table.
#             Requires DATABRICKS_CLIENT_ID + DATABRICKS_CLIENT_SECRET + DATABRICKS_WORKSPACE_ID.
#   oidc    — plain client-credentials grant against {host}/oidc/v1/token.
#   sdk     — Databricks Python SDK auto-detects credentials from the runtime.
#             Use this inside Databricks Apps (automatic SP auth) — no secrets needed.
DATABRICKS_AUTH_TYPE=oauth
DATABRICKS_AUTH_METHOD=zerobus
DATABRICKS_CLIENT_ID="<service-principal-application-id>"
DATABRICKS_CLIENT_SECRET="<service-principal-oauth-secret>"

# Zerobus Ingest OTLP endpoint: <workspace-id>.zerobus.<region>.cloud.databricks.com
# (used by the simulator's direct mode; collector configs have the host written in)
ZEROBUS_HOST="<workspace-id>.zerobus.<region>.cloud.databricks.com"

# ── Simulator ────────────────────────────────────────────────────────────
OTEL_SERVICE_NAME=otel-local-mac-emitter

# Sidecar mode: route signals through the local collectors (Fluent Bit, Telegraf, Alloy, Vector)
# Set to false to send directly to Databricks
OTEL_SIDECAR_MODE=true

# Tables for direct-mode telemetry (used when sidecar is OFF)
OTEL_DIRECT_SPANS_TABLE=bldemos.otel.direct_otel_spans
OTEL_DIRECT_LOGS_TABLE=bldemos.otel.direct_otel_logs
OTEL_DIRECT_METRICS_TABLE=bldemos.otel.direct_otel_metrics

# Optional: Genie space used by Ask Genie tab
GENIE_SPACE_ID=
