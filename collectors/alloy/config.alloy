// Grafana Alloy — Full OTel collector sidecar
// Receives all signals on localhost:4320 (HTTP), forwards to the Databricks Zerobus OTLP endpoint.
//
// Zerobus tokens are scoped to one table, so each exporter gets its own token.
// Environment variables (set by start-all.sh):
//   ZB_TOKEN_ALLOY_SPANS    — token for bldemos.otel.alloy_otel_spans
//   ZB_TOKEN_ALLOY_LOGS     — token for bldemos.otel.alloy_otel_logs
//   ZB_TOKEN_ALLOY_METRICS  — token for bldemos.otel.alloy_otel_metrics
//
// Previous: workspace REST endpoint (no longer in the docs)
//   endpoint:  https://fevm-bobertx3-aws-fevm.cloud.databricks.com
//   paths:     /api/2.0/tracing/otel/v1/traces, /api/2.0/tracing/otel/v1/logs, /api/2.0/otel/v1/metrics
//   headers:   X-Databricks-UC-Table-Name, X-Databricks-Workspace-Url
//
// Current: Zerobus Ingest OTLP endpoint
//   endpoint:  https://7474645374628060.zerobus.us-east-1.cloud.databricks.com
//   paths:     /v1/traces, /v1/logs, /v1/metrics
//   header:    x-databricks-zerobus-table-name

otelcol.receiver.otlp "default" {
  http {
    endpoint = "0.0.0.0:4320"
  }

  output {
    traces  = [otelcol.processor.batch.default.input]
    logs    = [otelcol.processor.batch.default.input]
    metrics = [otelcol.processor.batch.default.input]
  }
}

otelcol.processor.batch "default" {
  timeout = "2s"

  output {
    traces  = [otelcol.exporter.otlphttp.traces.input]
    logs    = [otelcol.exporter.otlphttp.logs.input]
    metrics = [otelcol.exporter.otlphttp.metrics.input]
  }
}

otelcol.exporter.otlphttp "traces" {
  client {
    endpoint = "https://7474645374628060.zerobus.us-east-1.cloud.databricks.com"
    headers = {
      "Authorization"                   = "Bearer " + env("ZB_TOKEN_ALLOY_SPANS"),
      "x-databricks-zerobus-table-name" = "bldemos.otel.alloy_otel_spans",
    }
    tls { insecure = false }
  }
  traces_endpoint = "https://7474645374628060.zerobus.us-east-1.cloud.databricks.com/v1/traces"
}

otelcol.exporter.otlphttp "logs" {
  client {
    endpoint = "https://7474645374628060.zerobus.us-east-1.cloud.databricks.com"
    headers = {
      "Authorization"                   = "Bearer " + env("ZB_TOKEN_ALLOY_LOGS"),
      "x-databricks-zerobus-table-name" = "bldemos.otel.alloy_otel_logs",
    }
    tls { insecure = false }
  }
  logs_endpoint = "https://7474645374628060.zerobus.us-east-1.cloud.databricks.com/v1/logs"
}

otelcol.exporter.otlphttp "metrics" {
  client {
    endpoint = "https://7474645374628060.zerobus.us-east-1.cloud.databricks.com"
    headers = {
      "Authorization"                   = "Bearer " + env("ZB_TOKEN_ALLOY_METRICS"),
      "x-databricks-zerobus-table-name" = "bldemos.otel.alloy_otel_metrics",
    }
    tls { insecure = false }
  }
  metrics_endpoint = "https://7474645374628060.zerobus.us-east-1.cloud.databricks.com/v1/metrics"
}
